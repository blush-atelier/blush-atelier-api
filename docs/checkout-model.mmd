%% Estados persistidos; Procesando pago es un paso de UI, no otro estado DB.
stateDiagram-v2
    state "PENDING / ACTIVE" as Pending
    state "APPROVED / CONFIRMED" as Approved
    state "DECLINED / RELEASED" as Declined
    state "ERROR / RELEASED" as Failed
    state "EXPIRED / RELEASED" as Expired
    [*] --> Pending: crear pedido y reservar todas las lineas
    Pending --> Pending: enviado o timeout sin resultado verificable
    Pending --> Approved: proveedor verificado, stock y entrega READY
    Pending --> Declined: rechazo o VOIDED verificado, liberar reserva
    Pending --> Failed: ERROR verificado, liberar reserva
    Pending --> Expired: 15 minutos y sin pago iniciado
    Approved --> [*]
    Declined --> [*]
    Failed --> [*]
    Expired --> [*]
    note right of Pending
      payment_submitted_at se confirma antes del POST.
      Duplicados no repiten cargo ni movimiento de stock.
      Un intento enviado no expira solo por tiempo.
    end note
